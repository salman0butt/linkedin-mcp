# M00 requires no LinkedIn credentials.
LINKEDIN_MCP_TRANSPORT=stdio
LINKEDIN_MCP_LOG_LEVEL=info
LINKEDIN_MCP_HTTP_HOST=127.0.0.1
LINKEDIN_MCP_HTTP_PORT=3000

# Optional OAuth: uncomment/configure only for a legitimate LinkedIn application.
# LINKEDIN_MCP_OAUTH_MODE=confidential
# LINKEDIN_MCP_CLIENT_ID=
# LINKEDIN_MCP_CLIENT_SECRET=
# LINKEDIN_MCP_REDIRECT_URI=
# LINKEDIN_MCP_OAUTH_SCOPES=openid profile email w_member_social
# LINKEDIN_MCP_CREDENTIAL_STORE_PATH=/absolute/private/path/credentials.json
# LINKEDIN_MCP_TOKEN_ENCRYPTION_KEY=
# Encryption key: canonical base64 of exactly 32 random bytes; never commit secrets.

# Optional text publishing: both explicit version and private ledger path are required.
# Choose a supported YYYYMM LinkedIn API version; no default is supplied.
# LINKEDIN_MCP_API_VERSION=
# LINKEDIN_MCP_IDEMPOTENCY_LEDGER_PATH=/absolute/private/path/mutations.json
# LINKEDIN_MCP_APPROVAL_TTL_MS=300000
# Read confirmation requires legitimate product access AND granted r_member_social.
# LINKEDIN_MCP_MEMBER_POST_READ_ENABLED=false

# Optional M03 local media staging. The root must already exist and be an absolute directory.
# Keep credential and idempotency files outside this root.
# LINKEDIN_MCP_MEDIA_ROOT=/absolute/path/to/media-staging
# Local safety bound only; valid range is 1 MiB through 50 MiB, default 20 MiB.
# LINKEDIN_MCP_MEDIA_MAX_BYTES=20971520
# Image-status reads can be restricted even when member image writes are granted; disabled by default.
# LINKEDIN_MCP_IMAGE_STATUS_READ_ENABLED=false
